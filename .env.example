# Copy to .env, chmod 600, and replace the example origin/key.
# `npm run setup` can generate this file interactively instead.
NODE_ENV=production
APP_ORIGIN=https://panel.example.com
PORT=3000
DATA_FILE=./data/database.json
SITE_NAME=CerdasNet VPS Control
SITE_TAGLINE=Cloud infrastructure, clearly controlled.
# Generate with: openssl rand -hex 32 (exactly 32 bytes / 64 hex characters)
TOKEN_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARACTERS

COOKIE_SECURE=true
TRUST_PROXY=1
LOG_LEVEL=info
SESSION_TTL_HOURS=12
SYNC_INTERVAL_SECONDS=300
SERVER_POLL_SECONDS=30
METRICS_REFRESH_SECONDS=300
METRICS_RETENTION_DAYS=30
AUTO_SYNC_ON_BOOT=true
CONTROL_VERIFY_ATTEMPTS=30
CONTROL_VERIFY_INTERVAL_MS=2000

# Optional for Docker Compose host port mapping:
BIND_ADDRESS=127.0.0.1
APP_PORT=3000

# Optional SMTP. The integration is disabled until SMTP_HOST and SMTP_FROM are set.
# Port 465 normally uses SMTP_SECURE=true; port 587 normally uses false + STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_CONNECTION_TIMEOUT_MS=10000

# Optional Google OIDC. Accounts are linked only to existing active panel users
# whose unique email exactly matches the provider-verified Google email.
# Authorized redirect URI: ${APP_ORIGIN}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Do NOT put UpCloud/Proxmox tokens or a permanent ADMIN_PASSWORD in this file.
# Add provider tokens through the panel; bootstrap credentials are supplied once,
# interactively, or through a secret environment only for the bootstrap process.
