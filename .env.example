# Docker Compose production configuration. Copy to .env, chmod 600, replace every CHANGE_ME.
APP_ORIGIN=https://panel.example.com
POSTGRES_DB=cerdasnet
POSTGRES_USER=cerdasnet
POSTGRES_PASSWORD=CHANGE_ME_USE_OPENSSL_RAND_BASE64_36
# Generate with: openssl rand -hex 32 (exactly 32 bytes / 64 hex characters)
TOKEN_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARACTERS

BIND_ADDRESS=127.0.0.1
APP_PORT=3000
TRUST_PROXY=1
LOG_LEVEL=info
SESSION_TTL_HOURS=12
SYNC_INTERVAL_SECONDS=300
SERVER_POLL_SECONDS=30
METRICS_REFRESH_SECONDS=300
METRICS_RETENTION_DAYS=30
AUTO_SYNC_ON_BOOT=true

# Do NOT put UpCloud tokens or a permanent ADMIN_PASSWORD in this file.
# Bootstrap admin once with docker compose run --rm -e ADMIN_USERNAME -e ADMIN_PASSWORD app npm run bootstrap:admin
